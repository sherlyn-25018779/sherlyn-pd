<footer class="site-footer">
  <% if (!currentPath.startsWith('/contact')) { %>
  <div class="container connect-strip">
    <h4>Let's Connect</h4>
    <div class="social-row">
      <a href="mailto:<%= site.email %>" aria-label="Email"><%- include('icon', { name: 'email' }) %></a>
      <a href="https://<%= site.linkedin %>" target="_blank" rel="noopener" aria-label="LinkedIn"><%- include('icon', { name: 'linkedin' }) %></a>
      <a href="https://<%= site.github %>" target="_blank" rel="noopener" aria-label="GitHub"><%- include('icon', { name: 'github' }) %></a>
    </div>
  </div>
  <% } %>
  <p class="copyright">© <%= year %> <%= site.name %>. All rights reserved.</p>
</footer>